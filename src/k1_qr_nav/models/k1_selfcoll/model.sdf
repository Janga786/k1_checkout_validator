    <joint name="ALeft_Shoulder_Pitch" type="revolute">
      <parent>base_link</parent><child>Left_Arm_1</child>
      <axis><xyz expressed_in="__model__">0.0 1.0 0.0</xyz>
        <limit><lower>-3.2</lower><upper>3.2</upper><effort>50</effort></limit><dynamics><damping>0.5</damping></dynamics></axis>
    </joint>
    <joint name="Left_Shoulder_Roll" type="revolute">
      <parent>Left_Arm_1</parent><child>Left_Arm_2</child>
      <axis><xyz expressed_in="__model__">1.0 0.0 0.0</xyz>
        <limit><lower>-3.2</lower><upper>3.2</upper><effort>50</effort></limit><dynamics><damping>0.5</damping></dynamics></axis>
    </joint>
    <joint name="Left_Elbow_Pitch" type="revolute">
      <parent>Left_Arm_2</parent><child>Left_Arm_3</child>
      <axis><xyz expressed_in="__model__">0.0 1.0 0.0</xyz>
        <limit><lower>-3.2</lower><upper>3.2</upper><effort>50</effort></limit><dynamics><damping>0.5</damping></dynamics></axis>
    </joint>
    <joint name="Left_Elbow_Yaw" type="revolute">
      <parent>Left_Arm_3</parent><child>left_hand_link</child>
      <axis><xyz expressed_in="__model__">0.0 0.0 1.0</xyz>
        <limit><lower>-3.2</lower><upper>3.2</upper><effort>50</effort></limit><dynamics><damping>0.5</damping></dynamics></axis>
    </joint>
