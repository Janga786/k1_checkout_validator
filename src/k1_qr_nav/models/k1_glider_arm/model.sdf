    </link>
    <link name="Left_Arm_3">
      <pose>0.00250 0.18943 0.79100 0.00000 -0.00000 0.00000</pose>
      <gravity>false</gravity>
      <inertial><mass>0.4</mass><inertia><ixx>0.01</ixx><iyy>0.01</iyy><izz>0.01</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial>
      <visual name="Left_Arm_3_v"><pose>0.00000 0.00000 0.00000 0.00000 -0.00000 0.00000</pose><geometry><mesh><uri>file:///home/boosterk1/booster_assets/robots/K1/meshes/Left_Arm_3.STL</uri><scale>1 1 1</scale></mesh></geometry><material><ambient>0.2 0.4 0.7 1</ambient><diffuse>0.3 0.55 0.9 1</diffuse></material></visual>
    </link>
    <link name="left_hand_link">
      <pose>0.00250 0.31093 0.79100 0.00000 -0.00000 0.00000</pose>
      <gravity>false</gravity>
      <inertial><mass>0.4</mass><inertia><ixx>0.01</ixx><iyy>0.01</iyy><izz>0.01</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial>
      <visual name="left_hand_link_v"><pose>0.00000 0.00000 0.00000 0.00000 -0.00000 0.00000</pose><geometry><mesh><uri>file:///home/boosterk1/booster_assets/robots/K1/meshes/Left_Arm_4.STL</uri><scale>1 1 1</scale></mesh></geometry><material><ambient>0.2 0.4 0.7 1</ambient><diffuse>0.3 0.55 0.9 1</diffuse></material></visual>
    </link>
    <joint name="ALeft_Shoulder_Pitch" type="revolute">
      <parent>base_link</parent><child>Left_Arm_1</child>
      <axis><xyz expressed_in="__model__">0.0 1.0 0.0</xyz>
        <limit><lower>-3.316</lower><upper>1.22</upper><effort>50</effort></limit>
        <dynamics><damping>0.3</damping></dynamics></axis>
    </joint>
    <joint name="Left_Shoulder_Roll" type="revolute">
      <parent>Left_Arm_1</parent><child>Left_Arm_2</child>
      <axis><xyz expressed_in="__model__">1.0 0.0 0.0</xyz>
        <limit><lower>-1.74</lower><upper>1.57</upper><effort>50</effort></limit>
        <dynamics><damping>0.3</damping></dynamics></axis>
    </joint>
    <joint name="Left_Elbow_Pitch" type="revolute">
      <parent>Left_Arm_2</parent><child>Left_Arm_3</child>
      <axis><xyz expressed_in="__model__">0.0 1.0 0.0</xyz>
        <limit><lower>-2.27</lower><upper>2.27</upper><effort>50</effort></limit>
        <dynamics><damping>0.3</damping></dynamics></axis>
    </joint>
    <joint name="Left_Elbow_Yaw" type="revolute">
      <parent>Left_Arm_3</parent><child>left_hand_link</child>
      <axis><xyz expressed_in="__model__">0.0 0.0 1.0</xyz>
        <limit><lower>-2.44</lower><upper>0.0</upper><effort>50</effort></limit>
        <dynamics><damping>0.3</damping></dynamics></axis>
    </joint>
    <plugin filename="gz-sim-velocity-control-system" name="gz::sim::systems::VelocityControl">
      <topic>cmd_vel</topic>
    </plugin>
    <plugin filename="gz-sim-odometry-publisher-system" name="gz::sim::systems::OdometryPublisher">
      <dimensions>2</dimensions><odom_frame>odom</odom_frame>
      <robot_base_frame>base_link</robot_base_frame>
      <odom_topic>odom</odom_topic><tf_topic>tf</tf_topic>
      <odom_publish_frequency>30</odom_publish_frequency>
    </plugin>
    <plugin filename="gz-sim-joint-state-publisher-system" name="gz::sim::systems::JointStatePublisher"/>
  <plugin filename="gz-sim-joint-position-controller-system"
    name="gz::sim::systems::JointPositionController">
    <joint_name>ALeft_Shoulder_Pitch</joint_name><topic>arm/j0</topic>
    <p_gain>40.0</p_gain><i_gain>0.0</i_gain><d_gain>3.0</d_gain></plugin>
  <plugin filename="gz-sim-joint-position-controller-system"
    name="gz::sim::systems::JointPositionController">
    <joint_name>Left_Shoulder_Roll</joint_name><topic>arm/j1</topic>
    <p_gain>40.0</p_gain><i_gain>0.0</i_gain><d_gain>3.0</d_gain></plugin>
  <plugin filename="gz-sim-joint-position-controller-system"
    name="gz::sim::systems::JointPositionController">
    <joint_name>Left_Elbow_Pitch</joint_name><topic>arm/j2</topic>
    <p_gain>40.0</p_gain><i_gain>0.0</i_gain><d_gain>3.0</d_gain></plugin>
  <plugin filename="gz-sim-joint-position-controller-system"
    name="gz::sim::systems::JointPositionController">
    <joint_name>Left_Elbow_Yaw</joint_name><topic>arm/j3</topic>
    <p_gain>40.0</p_gain><i_gain>0.0</i_gain><d_gain>3.0</d_gain></plugin>
  </model>
</sdf>
