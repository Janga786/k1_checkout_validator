<?xml version="1.0" ?>
<!-- Camera-only nav test world for the Booster K1 (NO LiDAR).
     The real K1 (k1_glider_cam: actual meshes on a gravity-off floating base that
     glides via /cmd_vel -- no walking controller needed) carries a gz rgbd_camera at
     the head (HFOV 90 deg, ~10 deg down). RTAB-Map maps from RGB+depth; Nav2 drives
     to a scan pose. Geometry matches the demo (QR box at 5.5,1.4 / 0.4 x 0.85).
     Distinct colours give the visual SLAM real features (mirrors the textureless risk). -->
<sdf version="1.10">
  <world name="camera_nav">
    <physics name="dart" type="dart">
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>

    <scene>
      <ambient>0.7 0.7 0.7 1</ambient>
      <background>0.5 0.6 0.7 1</background>
      <grid>false</grid>
    </scene>
    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>3 0 6 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.3 0.2 -0.9</direction>
    </light>

    <!-- ground -->
    <model name="ground">
      <static>true</static>
      <link name="link">
        <collision name="c"><geometry><plane><normal>0 0 1</normal><size>40 40</size></plane></geometry>
          <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface></collision>
        <visual name="v"><geometry><plane><normal>0 0 1</normal><size>40 40</size></plane></geometry>
          <material><ambient>0.8 0.8 0.8 1</ambient><diffuse>0.85 0.85 0.85 1</diffuse></material></visual>
      </link>
    </model>

    <!-- room perimeter walls (x[-1,6] y[-2,2]), 1.2 m tall, distinct colours = features -->
    <model name="walls"><static>true</static><link name="link">
      <collision name="cs"><pose>2.5 -2 0.6 0 0 0</pose><geometry><box><size>7 0.1 1.2</size></box></geometry></collision>
      <visual name="vs"><pose>2.5 -2 0.6 0 0 0</pose><geometry><box><size>7 0.1 1.2</size></box></geometry>
        <material><ambient>0.75 0.5 0.4 1</ambient><diffuse>0.8 0.55 0.45 1</diffuse></material></visual>
      <collision name="cn"><pose>2.5 2 0.6 0 0 0</pose><geometry><box><size>7 0.1 1.2</size></box></geometry></collision>
      <visual name="vn"><pose>2.5 2 0.6 0 0 0</pose><geometry><box><size>7 0.1 1.2</size></box></geometry>
        <material><ambient>0.4 0.55 0.7 1</ambient><diffuse>0.45 0.6 0.75 1</diffuse></material></visual>
      <collision name="cw"><pose>-1 0 0.6 0 0 0</pose><geometry><box><size>0.1 4 1.2</size></box></geometry></collision>
      <visual name="vw"><pose>-1 0 0.6 0 0 0</pose><geometry><box><size>0.1 4 1.2</size></box></geometry>
        <material><ambient>0.5 0.7 0.5 1</ambient><diffuse>0.55 0.75 0.55 1</diffuse></material></visual>
      <collision name="ce"><pose>6 0 0.6 0 0 0</pose><geometry><box><size>0.1 4 1.2</size></box></geometry></collision>
      <visual name="ve"><pose>6 0 0.6 0 0 0</pose><geometry><box><size>0.1 4 1.2</size></box></geometry>
        <material><ambient>0.7 0.65 0.4 1</ambient><diffuse>0.75 0.7 0.45 1</diffuse></material></visual>
    </link></model>

    <!-- obstacle (layout 0): central box at (2.75,-0.1), 0.5 x 1.2 footprint, 0.7 tall -->
    <model name="obstacle"><static>true</static><link name="link">
      <collision name="c"><pose>2.75 -0.1 0.35 0 0 0</pose><geometry><box><size>0.5 1.2 0.7</size></box></geometry></collision>
      <visual name="v"><pose>2.75 -0.1 0.35 0 0 0</pose><geometry><box><size>0.5 1.2 0.7</size></box></geometry>
        <material><ambient>0.85 0.3 0.3 1</ambient><diffuse>0.9 0.35 0.35 1</diffuse></material></visual>
    </link></model>

    <!-- QR box: 0.4 x 0.4 x 0.85 at (5.5,1.4); QR panel on the -x face at h=0.789 -->
    <model name="qr_box"><static>true</static><link name="link">
      <collision name="c"><pose>5.5 1.4 0.425 0 0 0</pose><geometry><box><size>0.4 0.4 0.85</size></box></geometry></collision>
      <visual name="v"><pose>5.5 1.4 0.425 0 0 0</pose><geometry><box><size>0.4 0.4 0.85</size></box></geometry>
        <material><ambient>0.55 0.4 0.25 1</ambient><diffuse>0.6 0.45 0.3 1</diffuse></material></visual>
      <visual name="qr_white"><pose>5.298 1.4 0.789 0 1.5708 0</pose><geometry><box><size>0.18 0.18 0.004</size></box></geometry>
        <material><ambient>0.95 0.95 0.95 1</ambient><diffuse>1 1 1 1</diffuse></material></visual>
      <visual name="qr_black"><pose>5.297 1.4 0.789 0 1.5708 0</pose><geometry><box><size>0.20 0.20 0.003</size></box></geometry>
        <material><ambient>0.05 0.05 0.05 1</ambient><diffuse>0.05 0.05 0.05 1</diffuse></material></visual>
    </link></model>

    <!-- ===================== the robot: the actual Booster K1 ===================== -->
    <!-- k1_glider_arm: real K1 with an ARTICULATED left arm (4 real joints +
         JointPositionControllers on arm/j0..j3, driven by arm_scan's IK so the
         scanner physically reaches the QR). Glides via /cmd_vel (VelocityControl)
         + publishes /odom. base_link at the floor (meshes pre-raised 0.62). -->
    <include>
      <uri>model://k1_glider_arm</uri>
      <name>k1</name>
      <pose>0 0 0 0 0 0</pose>
    </include>

  </world>
</sdf>
