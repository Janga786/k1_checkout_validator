<?xml version="1.0"?>
<sdf version="1.9">
  <world name="qr_room">
    <physics name="step" type="ignored">
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.3 0.2 -0.9</direction>
    </light>

    <model name="ground">
      <static>true</static>
      <link name="link">
        <collision name="c"><geometry><plane><normal>0 0 1</normal><size>40 40</size></plane></geometry></collision>
        <visual name="v">
          <geometry><plane><normal>0 0 1</normal><size>40 40</size></plane></geometry>
          <material><ambient>0.8 0.8 0.8 1</ambient><diffuse>0.85 0.85 0.85 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- room walls + one interior obstacle -->
    <model name="room">
      <static>true</static>
      <link name="link">
        <pose>0 0 0 0 0 0</pose>
        <!-- perimeter: room spans x[-1,7] y[-3,3], 1.5 m tall, 0.1 thick -->
        <collision name="cn"><pose>3 3 0.75 0 0 0</pose><geometry><box><size>8 0.1 1.5</size></box></geometry></collision>
        <visual    name="vn"><pose>3 3 0.75 0 0 0</pose><geometry><box><size>8 0.1 1.5</size></box></geometry><material><diffuse>0.7 0.72 0.78 1</diffuse></material></visual>
        <collision name="cs"><pose>3 -3 0.75 0 0 0</pose><geometry><box><size>8 0.1 1.5</size></box></geometry></collision>
        <visual    name="vs"><pose>3 -3 0.75 0 0 0</pose><geometry><box><size>8 0.1 1.5</size></box></geometry><material><diffuse>0.7 0.72 0.78 1</diffuse></material></visual>
        <collision name="ce"><pose>7 0 0.75 0 0 0</pose><geometry><box><size>0.1 6 1.5</size></box></geometry></collision>
        <visual    name="ve"><pose>7 0 0.75 0 0 0</pose><geometry><box><size>0.1 6 1.5</size></box></geometry><material><diffuse>0.7 0.72 0.78 1</diffuse></material></visual>
        <collision name="cw"><pose>-1 0 0.75 0 0 0</pose><geometry><box><size>0.1 6 1.5</size></box></geometry></collision>
        <visual    name="vw"><pose>-1 0 0.75 0 0 0</pose><geometry><box><size>0.1 6 1.5</size></box></geometry><material><diffuse>0.7 0.72 0.78 1</diffuse></material></visual>
        <!-- interior obstacle -->
        <collision name="co"><pose>3 0 0.5 0 0 0</pose><geometry><box><size>0.6 1.2 1.0</size></box></geometry></collision>
        <visual    name="vo"><pose>3 0 0.5 0 0 0</pose><geometry><box><size>0.6 1.2 1.0</size></box></geometry><material><diffuse>0.5 0.4 0.35 1</diffuse></material></visual>
      </link>
    </model>

    <!-- QR panel on the far wall (visual target; ground-truth detection uses its pose) -->
    <model name="qr_panel">
      <static>true</static>
      <pose>6.85 1.4 0.7 0 0 0</pose>
      <link name="link">
        <visual name="v">
          <geometry><box><size>0.04 0.5 0.5</size></box></geometry>
          <material>
            <ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse>
            <pbr><metal><albedo_map>file:///home/boosterk1/k1_qr_nav_ws/src/k1_qr_nav/worlds/qr_tex.png</albedo_map></metal></pbr>
          </material>
        </visual>
        <collision name="c"><geometry><box><size>0.04 0.5 0.5</size></box></geometry></collision>
      </link>
    </model>

    <include>
      <uri>model://k1_glider</uri>
      <pose>0 0 0.65 0 0 0</pose>
    </include>
  </world>
</sdf>
