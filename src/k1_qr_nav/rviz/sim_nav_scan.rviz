Panels:
  - Class: rviz_common/Displays
    Name: Displays
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Cell Size: 1.0
      Plane Cell Count: 16
      Color: 130; 130; 130
    - Class: rviz_default_plugins/Map
      Name: Map
      Enabled: true
      Topic:
        Value: /map
        Durability Policy: Transient Local
      Color Scheme: map
      Alpha: 0.5
    - Class: rviz_default_plugins/RobotModel
      Name: RobotModel
      Enabled: true
      Visual Enabled: true
      Collision Enabled: false
      Description Source: Topic
      Description Topic:
        Depth: 5
        Durability Policy: Transient Local
        Reliability Policy: Reliable
        Value: /robot_description
    - Class: rviz_default_plugins/Path
      Name: Plan
      Enabled: true
      Color: 25; 255; 100
      Topic:
        Value: /plan
        Durability Policy: Volatile
    - Class: rviz_default_plugins/LaserScan
      Name: Scan
      Enabled: true
      Size (m): 0.04
      Color: 255; 180; 0
      Topic:
        Value: /scan
        Durability Policy: Volatile
    - Class: rviz_default_plugins/MarkerArray
      Name: ScanMarkers
      Enabled: true
      Topic:
        Depth: 5
        Durability Policy: Volatile
        Reliability Policy: Reliable
        Value: /scan_markers
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: map
    Frame Rate: 30
  Tools:
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/FocusCamera
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Name: Current View
      Distance: 7.5
      Focal Point:
        X: 2.4
        Y: 0.7
        Z: 0.3
      Pitch: 0.42
      Yaw: 2.7
      Target Frame: map
Window Geometry:
  Height: 840
  Width: 1320
